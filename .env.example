# Скопируйте в .env и при необходимости измените

# Окно скачивания (дней назад от сегодня)
FETCH_WINDOW_DAYS=14

# Хранение данных (дней)
RETENTION_DAYS=60

# Размер пакета при очистке (дней)
CLEANUP_BATCH_DAYS=14

# API-ключ Государственной Думы (опционально, для api.duma.gov.ru)
# Получить: http://api.duma.gov.ru/
DUMA_API_KEY=

# ============================================================
# LLM для пояснительных записок — варианты, доступные в РФ
# LLM_PROVIDER: ollama | gigachat | yandex | deepseek | openai
# ============================================================

# --- Вариант 1: Ollama (рекомендуем для РФ) ---
# Полностью бесплатно, локально, без VPN и без регистрации API
# 1) Установите https://ollama.com
# 2) ollama pull qwen2.5:7b
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b

# --- Вариант 2: GigaChat от Сбера (облако, бесплатный freemium) ---
# ~900 000 токенов/год бесплатно для физлиц
# 1) https://developers.sber.ru/studio → GigaChat API → создать проект
# 2) Скопировать «Ключ авторизации» (Authorization key)
# LLM_PROVIDER=gigachat
# GIGACHAT_CREDENTIALS=ваш_ключ_авторизации_base64
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat

# --- Вариант 3: YandexGPT (облако, платный, стартовый грант ~4000₽) ---
# https://yandex.cloud → AI Studio → API-ключ + folder_id
# LLM_PROVIDER=yandex
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=b1g...

# --- DeepSeek (может работать из РФ, но нужен баланс на счёте) ---
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...

# Groq / Gemini / OpenRouter — часто недоступны из РФ без VPN

# Playwright для СОЗД — запасной режим, если HTTP-поиск пуст (true/false)
USE_PLAYWRIGHT_SOZD=false

# Tesseract OCR для сканированных PDF (pravo.gov.ru)
# Windows: winget install UB-Mannheim.TesseractOCR
# Русский язык: data/tessdata/rus.traineddata (скачивается при первой настройке)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_DIR=C:\ProgramData\LegalMonitor\tessdata
