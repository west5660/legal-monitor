# Скопируйте в .env и при необходимости измените

# Окно скачивания (дней назад от сегодня)
FETCH_WINDOW_DAYS=14

# Хранение данных (дней)
RETENTION_DAYS=60

# Размер пакета при очистке (дней)
CLEANUP_BATCH_DAYS=14

# API-ключ Государственной Думы (опционально, для api.duma.gov.ru)
# Получить: http://api.duma.gov.ru/
DUMA_API_KEY=

# Playwright для СОЗД — запасной режим, если HTTP-поиск пуст (true/false)
USE_PLAYWRIGHT_SOZD=false

# Tesseract OCR для сканированных PDF (pravo.gov.ru)
# Windows: winget install UB-Mannheim.TesseractOCR
# Русский язык: data/tessdata/rus.traineddata (скачивается при первой настройке)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_DIR=C:\ProgramData\LegalMonitor\tessdata
